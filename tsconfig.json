{
  // This file is not used in compilation. It is here just for a nice editor experience.
  //
  // The options below are @docusaurus/tsconfig inlined, minus `baseUrl`, which
  // TypeScript 7 removed. Extending that config directly fails: the removed
  // option is set there and cannot be unset from here.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
